{
    "compilerOptions": {
        "target": "ES2020",
        "module": "ESNext",
        "moduleResolution": "node",
        "strict": true,
        "skipLibCheck": true,
        "esModuleInterop": true,
        "jsx": "react-native",
        "isolatedModules": true,
        "resolveJsonModule": true,
        "noEmit": true
    },
    "include": ["src"]
}
